# ========================================
# AI-PatternWeb Environment Variables
# ========================================

# Database
DATABASE_URL=postgresql://patternweb:password@localhost:5432/patternweb
POSTGRES_USER=patternweb
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=patternweb

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
# Ayrı bir sır üretin: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI - Vertex AI Express Mode
VERTEX_API_KEY=your_vertex_express_mode_api_key_here
VERTEX_MODEL=gemini-3.5-flash

# Payment - Iyzico
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# App
ENVIRONMENT=development
TRUSTED_HOSTS=localhost,127.0.0.1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Google girişinde sunucu ve tarayıcı aynı web istemci kimliğini kullanmalı.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Object Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Email (for verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Webhooks (Zapier & n8n Entegrasyonu)
ZAPIER_WEBHOOK_URL=
N8N_WEBHOOK_URL=
